[
  {
    "id": "main",
    "components": [
      "section",
      "column-section"
    ]
  },
  {
    "id": "text",
    "rte": {
      "toolbar": {
        "format": ["bold", "italic", "underline", "strike", "code_inline", "text_color"],
        "alignment": ["left", "center", "right", "justify"],
        "direction": ["rtl", "ltr"],
        "indentation": ["indent", "outdent"],
        "blocks": ["paragraph", "h1", "h2", "h3", "h4", "h5", "h6", "code_block"],
        "list": ["bullet_list", "ordered_list"],
        "insert": ["link", "unlink", "image", "special_characters"],
        "sr_script": ["superscript", "subscript"],
        "editor": ["removeformat", "clean_unsupported_tags", "paste_text", "fullscreen", "find_and_replace"],
        "advanced": ["classes"],
        "sections": ["blocks", "format", "alignment", "indentation", "direction", "sr_script", "list", "insert", "editor", "advanced"]
      },
      "actions": {
        "image": {
          "wrapInPicture": false,
          "label": "Insert Image"
        },
        "classes": {
          "label": "Add Custom Class",
          "options": [
            { "value": "rte-indent", "label": "Indent" },
            { "value": "rte-outdent", "label": "Outdent" }
          ]
        }
      }
    }
  },
  {
    "...": "./_section.json#/filters"
  },
  {
    "...": "../blocks/*/_*.json#/filters"
  }
]
