        {
          "component": "select",
          "name": "style_width",
          "label": "Column Width",
          "description": "Width of this column on desktop. Sibling column sections authored next to each other are laid out side by side.",
          "value": "width-100",
          "options": [
            {
              "name": "10%",
              "value": "width-10"
            },
            {
              "name": "20%",
              "value": "width-20"
            },
            {
              "name": "30%",
