          "options": [
            {
              "name": "Highlight",
              "value": "highlight"
            },
            {
              "name": "Arc Background",
              "value": "arc-background"
            },
            {
              "name": "No Top Spacing",
              "value": "no-top-spacing"
            },
            {
              "name": "No Bottom Spacing",
              "value": "no-bottom-spacing"
            }
          ]
        }
      ]
    },
    {
      "id": "column-section",
