            },
            {
              "name": "80%",
              "value": "width-80"
            },
            {
              "name": "90%",
              "value": "width-90"
            },
            {
              "name": "Remaining Space",
              "value": "width-100"
            }
          ]
        },
        {
          "component": "select",
          "name": "style_background",
          "label": "Background Color",
          "description": "Optional background color for this column, using the site palette.",
