              "style_sectiontype": "column"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "section",
      "fields": [
        {
          "component": "tab",
          "name": "properties",
          "label": "Properties"
        },
        {
          "component": "text",
          "name": "name",
          "label": "Section Name",
          "description": "The label shown for this section in the Content Tree"
        },
        {
          "component": "tab",
          "name": "styles",
          "label": "Styles"
        },
        {
          "component": "multiselect",
          "name": "style",
