{
  "definitions": [
    {
      "title": "Related Articles",
      "id": "related-articles",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Related Articles",
              "model": "related-articles",
              "filter": "related-articles"
            }
          }
        }
      }
    },
    {
      "title": "News Story",
      "id": "related-news-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "News Story",
              "model": "related-news-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "related-articles",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "mode",
          "label": "Mode",
          "value": "dynamic",
          "description": "Dynamic lists articles automatically; Static shows the specific articles you choose; In the News shows the News Story items added to this block.",
          "options": [
            { "name": "Dynamic", "value": "dynamic" },
            { "name": "Static", "value": "static" },
            { "name": "In the News", "value": "news" }
          ]
        },
        {
          "component": "aem-content",
          "name": "category",
          "label": "Category",
          "rootPath": "/content/about-ups-eds",
          "validation": {
            "rootPath": "/content/about-ups-eds"
          },
          "description": "Select the category to list articles from. Leave blank to use siblings under the current page's parent.",
          "condition": { "!": { "in": [{ "var": "mode" }, ["static", "news"]] } }
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "articleCount",
          "label": "Number of Articles",
          "description": "How many articles to show, newest first, excluding the current page.",
          "value": 3,
          "condition": { "!": { "in": [{ "var": "mode" }, ["static", "news"]] } }
        },
        {
          "component": "aem-content",
          "name": "path1",
          "label": "Article 1",
          "rootPath": "/content/about-ups-eds",
          "validation": {
            "rootPath": "/content/about-ups-eds"
          },
          "description": "Select the first article to feature.",
          "condition": { "===": [{ "var": "mode" }, "static"] }
        },
        {
          "component": "aem-content",
          "name": "path2",
          "label": "Article 2",
          "rootPath": "/content/about-ups-eds",
          "validation": {
            "rootPath": "/content/about-ups-eds"
          },
          "description": "Optional second article.",
          "condition": { "===": [{ "var": "mode" }, "static"] }
        },
        {
          "component": "aem-content",
          "name": "path3",
          "label": "Article 3",
          "rootPath": "/content/about-ups-eds",
          "validation": {
            "rootPath": "/content/about-ups-eds"
          },
          "description": "Optional third article.",
          "condition": { "===": [{ "var": "mode" }, "static"] }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "showDate",
          "label": "Show Date",
          "description": "Show the published date on each card. Off by default."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "loadMoreLabel",
          "label": "Load More Button Label",
          "description": "Text on the Load More button (maximum 30 characters). Leave blank for \"Load more\".",
          "validation": {
            "maxLength": 30,
            "customErrorMsg": "Load More Button Label cannot exceed 30 characters"
          },
          "condition": { "===": [{ "var": "mode" }, "news"] }
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "desktopCount",
          "label": "Desktop initial load view count",
          "description": "News count to show in desktop view on page load (3 to 9). Also used on mobile.",
          "value": 3,
          "validation": {
            "numberMin": 3,
            "numberMax": 9
          },
          "condition": { "===": [{ "var": "mode" }, "news"] }
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "tabletCount",
          "label": "Tablet initial load view count",
          "description": "News count to show in tablet view on page load (2 to 8).",
          "value": 2,
          "validation": {
            "numberMin": 2,
            "numberMax": 8
          },
          "condition": { "===": [{ "var": "mode" }, "news"] }
        }
      ]
    },
    {
      "id": "related-news-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image alt text",
          "description": "Leave blank to use the News title.",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "source",
          "label": "External source name",
          "description": "Shown above the title, e.g. \"Reuters\"."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "News title",
          "required": true
        },
        {
          "component": "date-time",
          "valueType": "date",
          "name": "date",
          "label": "News Date",
          "displayFormat": "YYYY-MM-DD",
          "valueFormat": "YYYY-MM-DD",
          "description": "Shown on the card when Show Date is on."
        },
        {
          "component": "textarea",
          "valueType": "string",
          "name": "description",
          "label": "Description"
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "link",
          "label": "External source URL",
          "required": true,
          "description": "Page or external URL the card links to.",
          "validation": {
            "rootPath": "/content"
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "newTab",
          "label": "Open in New Tab",
          "value": false
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "related-articles",
      "components": [
        "related-news-item"
      ]
    }
  ]
}
