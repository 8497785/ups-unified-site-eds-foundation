{
  "definitions": [
    {
      "title": "Related Articles",
      "id": "related-articles",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Related Articles",
              "model": "related-articles"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "related-articles",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "mode",
          "label": "Mode",
          "value": "dynamic",
          "description": "Dynamic lists articles automatically; Static shows the specific articles you choose.",
          "options": [
            { "name": "Dynamic", "value": "dynamic" },
            { "name": "Static", "value": "static" }
          ]
        },
        {
          "component": "aem-content",
          "name": "category",
          "label": "Category",
          "rootPath": "/content/about-ups-eds",
          "validation": {
            "rootPath": "/content/about-ups-eds"
          },
          "description": "Select the category to list articles from. Leave blank to use siblings under the current page's parent.",
          "condition": { "!==": [{ "var": "mode" }, "static"] }
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "articleCount",
          "label": "Number of Articles",
          "description": "How many articles to show, newest first, excluding the current page.",
          "value": 3,
          "condition": { "!==": [{ "var": "mode" }, "static"] }
        },
        {
          "component": "aem-content",
          "name": "path1",
          "label": "Article 1",
          "rootPath": "/content/about-ups-eds",
          "validation": {
            "rootPath": "/content/about-ups-eds"
          },
          "description": "Select the first article to feature.",
          "condition": { "===": [{ "var": "mode" }, "static"] }
        },
        {
          "component": "aem-content",
          "name": "path2",
          "label": "Article 2",
          "rootPath": "/content/about-ups-eds",
          "validation": {
            "rootPath": "/content/about-ups-eds"
          },
          "description": "Optional second article.",
          "condition": { "===": [{ "var": "mode" }, "static"] }
        },
        {
          "component": "aem-content",
          "name": "path3",
          "label": "Article 3",
          "rootPath": "/content/about-ups-eds",
          "validation": {
            "rootPath": "/content/about-ups-eds"
          },
          "description": "Optional third article.",
          "condition": { "===": [{ "var": "mode" }, "static"] }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "showDate",
          "label": "Show Date",
          "description": "Show the published date on each card. Off by default."
        }
      ]
    }
  ],
  "filters": []
}
