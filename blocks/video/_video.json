{
  "definitions": [
    {
      "title": "Video",
      "id": "video",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Video",
              "model": "video"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "video",
      "fields": [
        {
          "component": "aem-content",
          "name": "link",
          "label": "Video Source",
          "description": "Paste a YouTube URL (youtube.com / youtu.be) or select a video asset from the DAM (e.g. an MP4 or a Dynamic Media video).",
          "validation": {
            "rootPath": "/content/dam/upsstories"
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "enablePlaceholderImage",
          "label": "Enable Placeholder Image",
          "value": false,
          "description": "Show a poster image with a play button; the video loads on click."
        },
        {
          "component": "reference",
          "name": "image",
          "label": "Placeholder Image",
          "multi": false,
          "condition": {
            "===": [
              {
                "var": "enablePlaceholderImage"
              },
              true
            ]
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Placeholder Alt Text",
          "description": "Accessible alt text for the placeholder image.",
          "condition": {
            "===": [
              {
                "var": "enablePlaceholderImage"
              },
              true
            ]
          }
        }
      ]
    }
  ],
  "filters": []
}
