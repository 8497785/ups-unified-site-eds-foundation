{
  "definitions": [
    {
      "title": "Video",
      "id": "video",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Video",
              "model": "video"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "video",
      "fields": [
        {
          "component": "select",
          "name": "videoType",
          "label": "Video Type",
          "value": "dam",
          "description": "Choose where the video comes from.",
          "options": [
            {
              "name": "AEM DAM",
              "value": "dam"
            },
            {
              "name": "External Video",
              "value": "external"
            }
          ]
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "DAM Video Asset",
          "description": "Select a video asset from the DAM (e.g. an MP4 or a Dynamic Media video).",
          "mimeTypes": [
            "video/*"
          ],
          "condition": {
            "===": [
              {
                "var": "videoType"
              },
              "dam"
            ]
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "externalUrl",
          "label": "External Video URL",
          "description": "Paste a YouTube URL (youtube.com / youtu.be).",
          "condition": {
            "===": [
              {
                "var": "videoType"
              },
              "external"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "enablePlaceholderImage",
          "label": "Enable Placeholder Image",
          "value": false,
          "description": "Show a poster image with a play button; the video loads on click."
        },
        {
          "component": "reference",
          "name": "image",
          "label": "Placeholder Image",
          "multi": false,
          "condition": {
            "===": [
              {
                "var": "enablePlaceholderImage"
              },
              true
            ]
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Placeholder Alt Text",
          "description": "Accessible alt text for the placeholder image.",
          "condition": {
            "===": [
              {
                "var": "enablePlaceholderImage"
              },
              true
            ]
          }
        }
      ]
    }
  ],
  "filters": []
}
