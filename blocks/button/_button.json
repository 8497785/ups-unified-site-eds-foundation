{
  "definitions": [
    {
      "title": "Button",
      "id": "button",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Button",
              "model": "button"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "button",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Button Label",
          "description": "The text shown on the button."
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Link",
          "description": "Optional. If set, the button renders as a link (anchor)."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "customClass",
          "label": "Custom Class",
          "description": "Optional. Extra CSS class(es) to add to the button."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "style",
          "label": "Style",
          "value": "primary",
          "options": [
            { "name": "Primary", "value": "primary" },
            { "name": "Secondary", "value": "secondary" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "alignment",
          "label": "Alignment",
          "value": "left",
          "options": [
            { "name": "Left", "value": "left" },
            { "name": "Center", "value": "center" },
            { "name": "Right", "value": "right" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "animation",
          "label": "Animation",
          "value": "",
          "description": "Entrance animation, played once when the button scrolls into view. Off by default.",
          "options": [
            { "name": "None", "value": "" },
            { "name": "Fade in up", "value": "fade-in-up" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "animationDelay",
          "label": "Animation Delay",
          "value": "1",
          "description": "Wait before the animation starts once the button is in view.",
          "options": [
            { "name": "None", "value": "0" },
            { "name": "0.5 seconds", "value": "0.5" },
            { "name": "1 second", "value": "1" },
            { "name": "2 seconds", "value": "2" }
          ],
          "condition": { "===": [{ "var": "animation" }, "fade-in-up"] }
        }
      ]
    }
  ],
  "filters": []
}
