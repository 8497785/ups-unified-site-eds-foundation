{
  "definitions": [
    {
      "title": "Content List",
      "id": "content-list",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Content List",
              "model": "content-list"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "content-list",
      "fields": [
        {
          "component": "aem-content",
          "name": "category",
          "label": "Category",
          "required": true,
          "rootPath": "/content/about-ups-eds",
          "validation": {
            "required": true,
            "rootPath": "/content/about-ups-eds"
          },
          "description": "Select the category page to list content from. Articles under this page are listed automatically."
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "pageSize",
          "label": "Items Per Page",
          "description": "How many items to show initially and per 'Load More' click.",
          "value": 12
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "loadMoreLabel",
          "label": "Load More Label",
          "value": "Load More"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "loadMoreStyle",
          "label": "Load More Button Style",
          "value": "primary",
          "options": [
            { "name": "Primary", "value": "primary" },
            { "name": "Secondary", "value": "secondary" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "loadMoreAlignment",
          "label": "Load More Button Alignment",
          "value": "center",
          "options": [
            { "name": "Left", "value": "left" },
            { "name": "Center", "value": "center" },
            { "name": "Right", "value": "right" }
          ]
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "showDate",
          "label": "Show Date",
          "description": "Show the published date on each card. Off by default."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "sortBy",
          "label": "Sort By",
          "description": "Optional. Defaults to newest first.",
          "options": [
            { "name": "Newest first", "value": "newest" },
            { "name": "Oldest first", "value": "oldest" },
            { "name": "Title (A–Z)", "value": "title" }
          ]
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "maxItems",
          "label": "Max Items",
          "description": "Optional. Maximum total items to list. Leave blank for no limit."
        }
      ]
    }
  ],
  "filters": []
}
