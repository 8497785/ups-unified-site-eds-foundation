{
  "definitions": [
    {
      "title": "Title",
      "id": "title-block",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Title",
              "model": "title-block"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "title-block",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Title"
        },
        {
          "component": "select",
          "name": "titleType",
          "value": "h2",
          "label": "Title Type",
          "options": [
            { "name": "H1", "value": "h1" },
            { "name": "H2", "value": "h2" },
            { "name": "H3", "value": "h3" },
            { "name": "H4", "value": "h4" },
            { "name": "H5", "value": "h5" },
            { "name": "H6", "value": "h6" }
          ]
        },
        {
          "component": "select",
          "name": "alignment",
          "value": "align-center",
          "label": "Alignment",
          "options": [
            { "name": "Left", "value": "align-left" },
            { "name": "Center", "value": "align-center" },
            { "name": "Right", "value": "align-right" }
          ]
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "showEyebrow",
          "label": "Show Eyebrow Line",
          "description": "Show a short gold accent line below the title."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "classes",
          "label": "Animation",
          "value": "",
          "description": "Entrance animation, played once when the title scrolls into view. Off by default.",
          "options": [
            { "name": "None", "value": "" },
            { "name": "Fade in up", "value": "animate-fade-in-up" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "classes_animationdelay",
          "label": "Animation Delay",
          "value": "animation-delay-0",
          "description": "Wait before the animation starts once the title is in view.",
          "options": [
            { "name": "None", "value": "animation-delay-0" },
            { "name": "0.5 seconds", "value": "animation-delay-0-5" },
            { "name": "1 second", "value": "animation-delay-1" },
            { "name": "2 seconds", "value": "animation-delay-2" }
          ],
          "condition": { "===": [{ "var": "classes" }, "animate-fade-in-up"] }
        }
      ]
    }
  ],
  "filters": []
}
