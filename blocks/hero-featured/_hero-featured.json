{
  "definitions": [
    {
      "title": "Hero Featured",
      "id": "hero-featured",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Hero Featured",
              "model": "hero-featured"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "hero-featured",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Alt",
          "value": ""
        },
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Text",
          "valueType": "string",
          "description": "Content card: title and description. The eyebrow and the CTA button come from the fields below."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "classes_eyebrow",
          "label": "Eyebrow",
          "value": "eyebrow-dynamic",
          "description": "Dynamic shows the name of the Link's parent page and links to it. Static uses the Eyebrow text and Eyebrow link below. None hides the eyebrow.",
          "options": [
            { "name": "Dynamic (parent page of Link)", "value": "eyebrow-dynamic" },
            { "name": "Static (authored)", "value": "eyebrow-static" },
            { "name": "None (no eyebrow)", "value": "eyebrow-none" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "topic",
          "label": "Eyebrow text",
          "value": "",
          "description": "Leave blank to show the name of the Eyebrow link page.",
          "condition": {
            "!": {
              "in": [
                {
                  "var": "classes_eyebrow"
                },
                [
                  "eyebrow-dynamic",
                  "eyebrow-none"
                ]
              ]
            }
          }
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "topicLink",
          "label": "Eyebrow link",
          "description": "Page the eyebrow links to. Leave blank to use the parent page of Link.",
          "condition": {
            "!": {
              "in": [
                {
                  "var": "classes_eyebrow"
                },
                [
                  "eyebrow-dynamic",
                  "eyebrow-none"
                ]
              ]
            }
          }
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "ctaLink",
          "label": "Link",
          "description": "Page the CTA button links to. With a Dynamic eyebrow, the eyebrow links to this page's parent."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ctaLinkText",
          "label": "CTA text",
          "value": "",
          "description": "CTA button text. The button is shown only when both Link and CTA text are filled in."
        },
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Presentation",
          "value": "",
          "description": "Optional modifiers. Full width removes the rounded container; alignment controls which side the content card sits on.",
          "options": [
            { "name": "Full width", "value": "full-width" },
            { "name": "Align card left", "value": "align-left" },
            { "name": "Align card right", "value": "align-right" }
          ]
        }
      ]
    }
  ],
  "filters": []
}
