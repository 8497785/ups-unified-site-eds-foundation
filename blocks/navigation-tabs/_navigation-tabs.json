{
  "definitions": [
    {
      "title": "Navigation Tabs",
      "id": "navigation-tabs",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Navigation Tabs",
              "model": "navigation-tabs"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "navigation-tabs",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "tabsSource",
          "label": "Tabs source",
          "value": "static",
          "description": "Static uses the Navigation Tab entries below. Dynamic creates one tab for each direct child page of the Navigation Root.",
          "options": [
            { "name": "Static", "value": "static" },
            { "name": "Dynamic", "value": "dynamic" }
          ]
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "navigationRoot",
          "label": "Navigation Root",
          "description": "One tab is created for each direct child page of this page.",
          "validation": {
            "rootPath": "/content/about-ups-eds"
          },
          "condition": {
            "===": [
              {
                "var": "tabsSource"
              },
              "dynamic"
            ]
          }
        },
        {
          "component": "container",
          "name": "navigationTab",
          "label": "Navigation Tab",
          "multi": true,
          "condition": {
            "!==": [
              {
                "var": "tabsSource"
              },
              "dynamic"
            ]
          },
          "fields": [
            {
              "component": "text",
              "valueType": "string",
              "name": "label",
              "label": "Navigation Label",
              "required": true,
              "description": "Text displayed for the tab (maximum 24 characters).",
              "validation": {
                "maxLength": 24,
                "customErrorMsg": "Navigation Label cannot exceed 24 characters"
              }
            },
            {
              "component": "aem-content",
              "valueType": "string",
              "name": "link",
              "label": "Navigation Links",
              "required": true,
              "description": "Target page.",
              "validation": {
                "rootPath": "/content/about-ups-eds"
              }
            },
            {
              "component": "boolean",
              "valueType": "boolean",
              "name": "target",
              "label": "Open in New Window",
              "value": false
            }
          ]
        }
      ]
    }
  ],
  "filters": []
}
